# AWS Agent Registry assignment for the AWS-hosted OpenClaw runtime.
# Copy to a private .env file or export values in the Lightsail shell.

AWS_REGION=ap-southeast-2
AWS_PROFILE=

# DynamoDB table used as the agent registry.
AGENT_REGISTRY_TABLE=OpenClawAgentRegistry

# SSM parameter that points callers at the currently assigned default agent.
ACTIVE_AGENT_PARAMETER=/openclaw/registry/active-agent

# OpenClaw agent record.
AGENT_ID=openclaw
AGENT_NAME=OpenClaw AWS Agent
AGENT_RUNTIME=openclaw
AGENT_PROVIDER=aws-lightsail
AGENT_OWNER=xtoken2000
AGENT_VERSION=2026.6.5
AGENT_STATUS=active
AGENT_AUTH=bearer_token
AGENT_SKILLS=openclaw,contractor,restaurant,research,commerce
AGENT_INPUT_SCHEMA={"message":"string","agent":"string","source":"string"}

# Use an HTTPS bridge URL if the agent should be invokable from outside the instance.
# Keep blank if the registry entry is discovery-only or internal.
AGENT_ENDPOINT=

# Comma-separated capability names.
AGENT_CAPABILITIES=telegram,whatsapp,farcaster,commerce,solana-invocation
