{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@openclaw-deagent/schemas": ["packages/schemas/src/index.ts"],
      "@openclaw-deagent/sdk": ["packages/deagent-sdk/src/index.ts"],
      "@openclaw-deagent/shared": ["packages/shared/src/index.ts"]
    }
  }
}
